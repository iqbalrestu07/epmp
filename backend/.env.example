APP_ENV=development
PORT=8080

# PostgreSQL — used by the server and golang-migrate
DATABASE_URL=postgres://postgres:postgres@localhost:5432/epmp?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=epmp
DB_SSLMODE=disable

# JWT — MUST be changed in production (use a long random string)
JWT_SECRET=epmp-dev-secret-change-in-production

# Token TTL — defaults: access 120 min (2h), refresh 30 days
# ACCESS_TOKEN_TTL_MINUTES=120
# REFRESH_TOKEN_TTL_DAYS=30

# Email notification channel — optional; disabled when SMTP_HOST is unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASSWORD=app-password
# SMTP_FROM=EPMP <noreply@example.com>
