# EPMP — root .env.example
# Copy to .env and adjust before running docker compose.
#
# cp .env.example .env

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development

# ── Ports ─────────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=epmp
DB_PORT=5432

# ── Frontend (baked into Vite bundle at build time) ───────────────────────────
VITE_API_BASE_URL=http://localhost:8080
